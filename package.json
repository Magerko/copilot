{
  "name": "copilot",
  "productName": "Copilot",
  "version": "0.2.0",
  "description": "Local-first AI interview & meeting copilot (BYOK)",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win nsis",
    "dist:mac": "electron-vite build && electron-builder --mac dmg",
    "icon": "node scripts/make-icon.ts",
    "dist:dir": "electron-vite build && electron-builder --win dir",
    "dist:mac:dir": "electron-vite build && electron-builder --mac dir",
    "install:mac": "electron-vite build && electron-builder --mac dir --arm64 && sh scripts/sign-mac.sh && ditto release/mac-arm64/Copilot.app /Applications/Copilot.app"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "mammoth": "^1.13.0",
    "onnxruntime-node": "^1.31.1",
    "pdfjs-dist": "^5.7.284",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "author": "Copilot",
  "build": {
    "appId": "app.copilot",
    "productName": "Copilot",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/onnxruntime-node/**"
    ],
    "extraResources": [
      {
        "from": "resources/silero_vad.onnx",
        "to": "silero_vad.onnx"
      }
    ],
    "win": {
      "executableName": "Copilot",
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Copilot распознаёт вашу речь локально, чтобы подсказывать ответы.",
        "NSAudioCaptureUsageDescription": "Copilot слушает звук собеседника, чтобы распознать вопрос.",
        "NSScreenCaptureUsageDescription": "Copilot делает снимок выбранной области экрана только по вашей команде."
      }
    },
    "dmg": {
      "artifactName": "Copilot-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Copilot Setup ${version}.${ext}",
      "uninstallDisplayName": "Copilot",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Copilot",
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "ru",
      "uk",
      "en-US",
      "en"
    ]
  },
  "license": "MIT"
}
